# Public site identity (embedded at Next.js build time via NEXT_PUBLIC_*).
NEXT_PUBLIC_SITE_URL=https://qubixsolution.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@qubixsolution.com

# Contact form POST target (FastAPI — see backend/.env.example for SMTP secrets).
# Local dev defaults to localhost:8000 when unset during build.
NEXT_PUBLIC_CONTACT_API_URL=http://localhost:8000/contact

# Docker Compose overrides this at web build-time to `/backend/contact` so nginx
# proxies `/backend/*` to the `api` service on the same host.
