# Public site identity (embedded at Next.js build time via NEXT_PUBLIC_*).
NEXT_PUBLIC_SITE_URL=https://qubixsolution.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@qubixsolution.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+923164720321

# Where Next.js proxies POST `/api/contact` (server-side only — not exposed to the browser).
# Local: FastAPI default. Docker Compose sets `CONTACT_BACKEND_URL=http://api:8000/contact` on the `web` service.
CONTACT_BACKEND_URL=http://127.0.0.1:8000/contact

# Optional: nginx can still expose `/backend/*` directly to FastAPI; the SPA uses `/api/contact` instead.
