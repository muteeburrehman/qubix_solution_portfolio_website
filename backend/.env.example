# ---------------------------------------------------------------------------
# Qubix contact API — copy to `backend/.env` before running Compose or uvicorn.
# Never commit `.env`; keep secrets out of Git.
# ---------------------------------------------------------------------------

# Hostinger SMTP (STARTTLS — port 587)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587

EMAIL_USER=support@qubixsolution.com

# Mailbox password — create an app/password in Hostinger hPanel when available.
EMAIL_PASS=

# Allowed browser origins for CORS (comma-separated). No spaces; no trailing `>`
# (easy copy-paste mistake — that breaks the real site origin and preflight fails).
# Example production + dev:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://qubixsolution.com,https://www.qubixsolution.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://qubixsolution.com,https://www.qubixsolution.com

# Logging
LOG_LEVEL=INFO
